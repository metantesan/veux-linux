# SPDX-License-Identifier: GPL-2.0-only
# Local mainline bring-up rootfs; stage with tools/stage-rootfs-packages.py.
maintainer="hikari <me@metantesan.com>"
pkgname=device-xiaomi-veux-mainline
pkgver=1
pkgrel=10
pkgdesc="Xiaomi veux mainline development device"
url="https://postmarketos.org"
arch="aarch64"
license="GPL-2.0-only"
depends="
	linux-xiaomi-veux-mainline postmarketos-base unudhcpd agetty
	linux-firmware-ath10k firmware-xiaomi-veux-modem rmtfs>=1.3-r1 rmtfs-systemd qrtr tqftpserv tqftpserv-systemd networkmanager veux-wifi veux-sim veux-audio-bringup veux-usbc-pd veux-aw8624-feedbackd
"
makedepends="devicepkg-dev"
source="deviceinfo 20-veux-usb.conf 20-veux-manual.conf"
options="!check !archcheck"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"
	install -Dm644 "$srcdir/20-veux-usb.conf" \
		"$pkgdir/etc/NetworkManager/conf.d/20-veux-usb.conf"
	install -Dm644 "$srcdir/20-veux-manual.conf" \
		"$pkgdir/etc/systemd/system/rmtfs.service.d/20-veux-manual.conf"
	install -d -m700 "$pkgdir/var/lib/rmtfs"
	mkdir -p "$pkgdir/etc/systemd/system/mainline-bringup.target.wants"
	for unit in NetworkManager rmtfs tqftpserv; do
		ln -s "/usr/lib/systemd/system/$unit.service" \
			"$pkgdir/etc/systemd/system/mainline-bringup.target.wants/$unit.service"
	done
}

# Filled in the staged copy by stage-rootfs-packages.py.
sha512sums=""
