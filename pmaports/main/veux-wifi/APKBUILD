# SPDX-License-Identifier: GPL-2.0-only
maintainer="hikari <me@metantesan.com>"
pkgname=veux-wifi
pkgver=1
pkgrel=6
pkgdesc="Xiaomi veux WLAN startup and stable network addresses"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
depends="systemd systemd-timesyncd networkmanager qrtr python3 rmtfs>=1.3-r1 rmtfs-systemd
 tqftpserv tqftpserv-systemd firmware-xiaomi-veux-modem>=1-r1"
source="veux-wifi.service veux-wifi.timer veux-wifi-start veux-qrtr-reannounce 30-veux-wifi-rmtfs.conf
 30-veux-wifi-mac.conf 30-veux-wifi-modemmanager.conf 60-veux-wifi.preset"
options="!check"

package() {
	install -Dm755 "$srcdir/veux-wifi-start" "$pkgdir/usr/libexec/veux-wifi-start"
	install -Dm755 "$srcdir/veux-qrtr-reannounce" "$pkgdir/usr/libexec/veux-qrtr-reannounce"
	install -Dm644 "$srcdir/veux-wifi.service" "$pkgdir/usr/lib/systemd/system/veux-wifi.service"
	install -Dm644 "$srcdir/veux-wifi.timer" "$pkgdir/usr/lib/systemd/system/veux-wifi.timer"
	install -Dm644 "$srcdir/60-veux-wifi.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/60-veux-wifi.preset"
	install -Dm644 "$srcdir/30-veux-wifi-rmtfs.conf" \
		"$pkgdir/usr/lib/systemd/system/rmtfs.service.d/30-veux-wifi.conf"
	install -Dm644 "$srcdir/30-veux-wifi-modemmanager.conf" \
		"$pkgdir/usr/lib/systemd/system/ModemManager.service.d/30-veux-wifi.conf"
	install -Dm644 "$srcdir/30-veux-wifi-mac.conf" \
		"$pkgdir/usr/lib/NetworkManager/conf.d/30-veux-wifi-mac.conf"
	for target in mainline-bringup multi-user; do
		install -d "$pkgdir/etc/systemd/system/$target.target.wants"
		ln -s /usr/lib/systemd/system/veux-wifi.timer \
			"$pkgdir/etc/systemd/system/$target.target.wants/veux-wifi.timer"
	done
}

# Filled in the staged copy by stage-rootfs-packages.py.
sha512sums=""
