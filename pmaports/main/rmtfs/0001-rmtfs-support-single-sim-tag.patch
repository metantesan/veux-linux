--- a/rmtfs.c
+++ b/rmtfs.c
@@ -343,6 +343,59 @@ respond:
 			strerror(-ret));
 }
 
+static void rmtfs_get_single_sim_tag(int sock, const struct qrtr_packet *pkt)
+{
+	struct rmtfs_sim_tag_resp resp = {};
+	struct rmtfs_sim_tag_req req = {};
+	DEFINE_QRTR_PACKET(resp_buf, 256);
+	struct rmtfd *rmtfd;
+	unsigned txn = 0;
+	ssize_t len;
+	int ret;
+
+	ret = qmi_decode_message(&req, &txn, pkt, QMI_REQUEST,
+				 QMI_RMTFS_GET_SINGLE_SIM_TAG,
+				 rmtfs_sim_tag_req_ei);
+	if (ret < 0) {
+		qmi_result_error(&resp.result, QMI_RMTFS_ERR_MALFORMED_MSG);
+		goto respond;
+	}
+
+	if (req.caller_id > INT_MAX) {
+		qmi_result_error(&resp.result, QMI_RMTFS_ERR_INVALID_CLIENT);
+		goto respond;
+	}
+	rmtfd = storage_get(pkt->node, (int)req.caller_id);
+	if (!rmtfd) {
+		/* Match rmt_storage's invalid-client response (QMI error 3). */
+		qmi_result_error(&resp.result, QMI_RMTFS_ERR_INVALID_CLIENT);
+		goto respond;
+	}
+
+	/* Stock veux rmt_storage defaults ro.miui.singlesim to "2". */
+	resp.single_sim_tag = 2;
+	resp.single_sim_tag_valid = true;
+
+respond:
+	dbgprintf("[RMTFS] single_sim_tag %u => %u (%u:%u)\n",
+		  req.caller_id, resp.single_sim_tag,
+		  resp.result.result, resp.result.error);
+	len = qmi_encode_message(&resp_buf, QMI_RESPONSE,
+				 QMI_RMTFS_GET_SINGLE_SIM_TAG, txn,
+				 &resp, rmtfs_sim_tag_resp_ei);
+	if (len < 0) {
+		fprintf(stderr, "[RMTFS] failed to encode single-sim-tag response: %s\n",
+			strerror(-len));
+		return;
+	}
+
+	ret = qrtr_sendto(sock, pkt->node, pkt->port,
+			  resp_buf.data, resp_buf.data_len);
+	if (ret < 0)
+		fprintf(stderr, "[RMTFS] failed to send single-sim-tag response: %s\n",
+			strerror(-ret));
+}
+
 static int rmtfs_bye(uint32_t node)
 {
 	dbgprintf("[RMTFS] bye from %d\n", node);
