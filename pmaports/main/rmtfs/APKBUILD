maintainer="hikari <me@metantesan.com>"
pkgname=rmtfs
pkgver=1.3
pkgrel=1
pkgdesc="Qualcomm Remote Filesystem Service Implementation"
url="https://github.com/linux-msm/rmtfs"
arch="aarch64"
license="BSD-3-Clause"
options="!check"
depends="qrtr"
makedepends="qrtr-dev eudev-dev"
subpackages="$pkgname-systemd $pkgname-udev"
source="
	rmtfs-$pkgver.tar.gz
	0001-rmtfs-support-single-sim-tag.patch
"
builddir="$srcdir/rmtfs-$pkgver"

build() {
	# The patched QMI C/header are included in the source; qmic is not needed.
	touch qmi_rmtfs.c qmi_rmtfs.h
	make prefix=/usr RMTFS_EFS_PATH=/var/lib/rmtfs CC="$CC" CFLAGS="$CFLAGS" \
		LDFLAGS="$LDFLAGS -lqrtr -ludev -pthread" rmtfs
}

package() {
	install -Dm755 "$builddir"/rmtfs "$pkgdir"/usr/bin/rmtfs
}

systemd() {
	pkgdesc="$pkgdesc (systemd files)"
	install_if="systemd $pkgname=$pkgver-r$pkgrel"
	install -d "$subpkgdir"/usr/lib/systemd/system
	sed -e 's+RMTFS_PATH+/usr/bin+g' -e 's+RMTFS_EFS_PATH+/var/lib/rmtfs+g' \
		"$builddir"/rmtfs.service.in > "$subpkgdir"/usr/lib/systemd/system/rmtfs.service
	sed -e 's+RMTFS_PATH+/usr/bin+g' -e 's+RMTFS_EFS_PATH+/var/lib/rmtfs+g' \
		"$builddir"/rmtfs-dir.service.in > "$subpkgdir"/usr/lib/systemd/system/rmtfs-dir.service
}

udev() {
	pkgdesc="$pkgdesc (udev rules)"
	install_if="udev $pkgname=$pkgver-r$pkgrel"
	install -Dm644 "$builddir"/rmtfs.rules "$subpkgdir"/usr/lib/udev/rules.d/rmtfs.rules
}

sha512sums="
