#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

modules=/usr/lib/veux-usbc-pd
for module in tcpm tcpci tcpci_rt1711h; do
	[ -e "/sys/module/$module" ] && continue
	insmod "$modules/$module.ko"
done

for attempt in $(seq 1 20); do
	for device in /sys/bus/i2c/devices/*-004e; do
		[ -L "$device/driver" ] || continue
		[ "$(basename "$(readlink -f "$device/driver")")" = rt1711h ] && exit 0
	done
	sleep 1
done
echo 'veux-usbc-pd: HUSB311-compatible controller at I2C address 0x4e did not bind to rt1711h' >&2
exit 1
