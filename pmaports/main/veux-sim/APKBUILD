# SPDX-License-Identifier: GPL-2.0-only
maintainer="hikari <me@metantesan.com>"
pkgname=veux-sim
pkgver=1
pkgrel=3
pkgdesc="Activate the USIM provisioning session on Xiaomi veux"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
depends="systemd modemmanager-systemd qmi-utils veux-wifi"
source="veux-sim.service veux-sim.timer veux-sim-start 60-veux-sim.preset"
options="!check"

package() {
	install -Dm755 "$srcdir/veux-sim-start" "$pkgdir/usr/libexec/veux-sim-start"
	install -Dm644 "$srcdir/veux-sim.service" \
		"$pkgdir/usr/lib/systemd/system/veux-sim.service"
	install -Dm644 "$srcdir/veux-sim.timer" \
		"$pkgdir/usr/lib/systemd/system/veux-sim.timer"
	install -Dm644 "$srcdir/60-veux-sim.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/60-veux-sim.preset"
	for target in mainline-bringup multi-user; do
		install -d "$pkgdir/etc/systemd/system/$target.target.wants"
		ln -s /usr/lib/systemd/system/veux-sim.timer \
			"$pkgdir/etc/systemd/system/$target.target.wants/veux-sim.timer"
	done
}

# Filled in the staged copy by stage-rootfs-packages.py.
sha512sums=""
