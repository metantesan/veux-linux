+config VIDEO_S5KHM2_ID_PROBE
+	bool "Xiaomi veux S5KHM2 one-shot identity probe"
+	depends on I2C && COMMON_CLK && GPIOLIB && REGULATOR
+	help
+	  Power the stock veux main camera briefly, read its candidate 16-bit
+	  identity register once, then power it back down. This does not expose
+	  a V4L2 subdevice, program mode tables, or start CSI streaming.
+
