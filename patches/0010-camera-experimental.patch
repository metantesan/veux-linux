diff --git a/drivers/media/i2c/s5khm2_probe.c b/drivers/media/i2c/s5khm2_probe.c
new file mode 100644
index 000000000..99f393d8e
--- /dev/null
+++ b/drivers/media/i2c/s5khm2_probe.c
@@ -0,0 +1,245 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * One-shot identity probe for the stock Xiaomi veux S5KHM2 main camera.
+ * It deliberately does not expose a V4L2 subdevice or program sensor modes.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+
+#define VEUX_S5KHM2_ID_REG	0x0000
+#define VEUX_S5KHM2_ID		0x1ad2
+#define VEUX_S5KHM2_XCLK_HZ	19200000
+
+struct veux_s5khm2_probe {
+	struct clk *xclk;
+	struct regulator *vdig;
+	struct gpio_desc *reset;
+	struct gpio_desc *vana;
+	struct gpio_desc *vio;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *pins_default;
+	struct pinctrl_state *pins_sleep;
+	bool vdig_enabled;
+	bool xclk_enabled;
+};
+
+static void veux_s5khm2_power_off(struct device *dev,
+				  struct veux_s5khm2_probe *probe)
+{
+	if (probe->xclk_enabled) {
+		clk_disable_unprepare(probe->xclk);
+		probe->xclk_enabled = false;
+	}
+
+	/* reset is active-low; logical 1 asserts it. */
+	gpiod_set_value_cansleep(probe->reset, 1);
+	msleep(1);
+	gpiod_set_value_cansleep(probe->vio, 0);
+	msleep(1);
+	gpiod_set_value_cansleep(probe->vana, 0);
+	msleep(1);
+
+	if (probe->vdig_enabled) {
+		int ret = regulator_disable(probe->vdig);
+
+		if (ret)
+			dev_warn(dev, "failed to disable VDIG: %d\n", ret);
+		else
+			probe->vdig_enabled = false;
+	}
+	msleep(1);
+}
+
+static int veux_s5khm2_power_on(struct veux_s5khm2_probe *probe)
+{
+	int ret;
+
+	/* Stock slot-0 order: VDIG, VANA, VIO, reset release, then MCLK. */
+	gpiod_set_value_cansleep(probe->reset, 1);
+
+	ret = regulator_enable(probe->vdig);
+	if (ret)
+		return ret;
+	probe->vdig_enabled = true;
+	msleep(1);
+
+	gpiod_set_value_cansleep(probe->vana, 1);
+	msleep(1);
+	gpiod_set_value_cansleep(probe->vio, 1);
+	msleep(1);
+	gpiod_set_value_cansleep(probe->reset, 0);
+	msleep(1);
+
+	ret = clk_set_rate(probe->xclk, VEUX_S5KHM2_XCLK_HZ);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(probe->xclk);
+	if (ret)
+		return ret;
+	probe->xclk_enabled = true;
+	msleep(13);
+
+	return 0;
+}
+
+static int veux_s5khm2_read_id(struct i2c_client *client, u16 *id)
+{
+	u8 address[] = { VEUX_S5KHM2_ID_REG >> 8, VEUX_S5KHM2_ID_REG & 0xff };
+	u8 data[2];
+	struct i2c_msg messages[] = {
+		{
+			.addr = client->addr,
+			.len = sizeof(address),
+			.buf = address,
+		},
+		{
+			.addr = client->addr,
+			.flags = I2C_M_RD,
+			.len = sizeof(data),
+			.buf = data,
+		},
+	};
+	int ret;
+
+	ret = i2c_transfer(client->adapter, messages, ARRAY_SIZE(messages));
+	if (ret < 0)
+		return ret;
+	if (ret != 2)
+		return -EIO;
+
+	*id = ((u16)data[0] << 8) | data[1];
+	return 0;
+}
+
+static int veux_s5khm2_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct veux_s5khm2_probe *probe;
+	u16 id = 0;
+	int ret;
+
+	if (client->addr != 0x10)
+		return dev_err_probe(dev, -EINVAL, "unexpected 7-bit address 0x%02x\n",
+				     client->addr);
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(dev, -EOPNOTSUPP, "adapter lacks raw I2C transfers\n");
+
+	probe = devm_kzalloc(dev, sizeof(*probe), GFP_KERNEL);
+	if (!probe)
+		return -ENOMEM;
+
+	probe->vdig = devm_regulator_get(dev, "vdig");
+	if (IS_ERR(probe->vdig))
+		return dev_err_probe(dev, PTR_ERR(probe->vdig), "failed to get VDIG\n");
+
+	probe->xclk = devm_clk_get(dev, "xclk");
+	if (IS_ERR(probe->xclk))
+		return dev_err_probe(dev, PTR_ERR(probe->xclk), "failed to get MCLK\n");
+
+	probe->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(probe->reset))
+		return dev_err_probe(dev, PTR_ERR(probe->reset), "failed to get reset GPIO\n");
+
+	probe->vana = devm_gpiod_get(dev, "vana", GPIOD_OUT_LOW);
+	if (IS_ERR(probe->vana))
+		return dev_err_probe(dev, PTR_ERR(probe->vana), "failed to get VANA GPIO\n");
+
+	probe->vio = devm_gpiod_get(dev, "vio", GPIOD_OUT_LOW);
+	if (IS_ERR(probe->vio))
+		return dev_err_probe(dev, PTR_ERR(probe->vio), "failed to get VIO GPIO\n");
+
+	probe->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(probe->pinctrl))
+		return dev_err_probe(dev, PTR_ERR(probe->pinctrl),
+				     "failed to get camera pinctrl\n");
+	probe->pins_default = pinctrl_lookup_state(probe->pinctrl, "default");
+	if (IS_ERR(probe->pins_default))
+		return dev_err_probe(dev, PTR_ERR(probe->pins_default),
+				     "failed to get active camera pins\n");
+	probe->pins_sleep = pinctrl_lookup_state(probe->pinctrl, "sleep");
+	if (IS_ERR(probe->pins_sleep))
+		return dev_err_probe(dev, PTR_ERR(probe->pins_sleep),
+				     "failed to get sleep camera pins\n");
+
+	/*
+	 * The stock Android sensor sequence enables cam_clk (CAMSS_TOP_GDSC)
+	 * before MCLK. Keep the same domain on for GPIO, clock, and CCI access.
+	 */
+	pm_runtime_set_suspended(dev);
+	pm_runtime_enable(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0) {
+		pm_runtime_disable(dev);
+		return dev_err_probe(dev, ret, "failed to enable CAMSS power domain\n");
+	}
+	dev_info(dev, "CAMSS top power domain enabled for sensor probe\n");
+
+	ret = pinctrl_select_state(probe->pinctrl, probe->pins_default);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to select active camera pins\n");
+		goto power_domain_off;
+	}
+
+	ret = veux_s5khm2_power_on(probe);
+	if (!ret) {
+		dev_info(dev,
+			 "powered for ID read: reset=%d VANA=%d VIO=%d VDIG=%d xclk=%lu\n",
+			 gpiod_get_value_cansleep(probe->reset),
+			 gpiod_get_value_cansleep(probe->vana),
+			 gpiod_get_value_cansleep(probe->vio),
+			 regulator_is_enabled(probe->vdig),
+			 clk_get_rate(probe->xclk));
+		ret = veux_s5khm2_read_id(client, &id);
+	}
+	veux_s5khm2_power_off(dev, probe);
+	ret = pinctrl_select_state(probe->pinctrl, probe->pins_sleep) ?: ret;
+
+power_domain_off:
+	pm_runtime_put_sync(dev);
+	pm_runtime_disable(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "one-shot sensor ID read failed\n");
+	if (id != VEUX_S5KHM2_ID)
+		return dev_err_probe(dev, -ENODEV,
+				     "sensor ID 0x%04x did not match expected 0x%04x\n",
+				     id, VEUX_S5KHM2_ID);
+
+	dev_info(dev, "sensor ID 0x%04x matched; sensor powered back down\n", id);
+	return 0;
+}
+
+static const struct of_device_id veux_s5khm2_of_match[] = {
+	{ .compatible = "xiaomi,veux-s5khm2-id-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, veux_s5khm2_of_match);
+
+static const struct i2c_device_id veux_s5khm2_id[] = {
+	{ "veux-s5khm2-id-probe", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, veux_s5khm2_id);
+
+static struct i2c_driver veux_s5khm2_driver = {
+	.driver = {
+		.name = "veux-s5khm2-id-probe",
+		.of_match_table = veux_s5khm2_of_match,
+	},
+	.probe = veux_s5khm2_probe,
+	.id_table = veux_s5khm2_id,
+};
+module_i2c_driver(veux_s5khm2_driver);
+
+MODULE_DESCRIPTION("Xiaomi veux S5KHM2 one-shot identity probe");
+MODULE_LICENSE("GPL");
