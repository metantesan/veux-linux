+static int cci_init_for_first_xfer(struct cci *cci)
+{
+	int ret = 0;
+
+	mutex_lock(&cci->init_lock);
+	if (cci->needs_first_xfer_init) {
+		ret = cci_reset(cci);
+		if (!ret)
+			cci->needs_first_xfer_init = false;
+	}
+	mutex_unlock(&cci->init_lock);
+
+	return ret;
+}
+
+static void cci_log_tlmm_levels(struct cci *cci, const char *stage)
+{
+	u32 sda_ctl, sda_io, scl_ctl, scl_io;
+
+	if (!cci->tlmm_base)
+		return;
+
+	sda_ctl = readl(cci->tlmm_base + TLMM_GPIO39_CTL_REG);
+	sda_io = readl(cci->tlmm_base + TLMM_GPIO39_IO_REG);
+	scl_ctl = readl(cci->tlmm_base + TLMM_GPIO40_CTL_REG);
+	scl_io = readl(cci->tlmm_base + TLMM_GPIO40_IO_REG);
+	dev_err(cci->dev,
+		"%s CCI pads: GPIO39 SDA=%u ctl=%#x GPIO40 SCL=%u ctl=%#x\n",
+		stage, (unsigned int)!!(sda_io & BIT(0)), sda_ctl,
+		(unsigned int)!!(scl_io & BIT(0)), scl_ctl);
+}
+
+static int cci_probe_gpio_input_levels(struct cci *cci)
+{
+	int ret;
+
+	if (!cci->pinctrl || !cci->pins_default || !cci->pins_gpio_probe)
+		return 0;
+
+	ret = pinctrl_select_state(cci->pinctrl, cci->pins_gpio_probe);
+	if (ret) {
+		dev_err(cci->dev, "failed to select GPIO-input probe state: %d\n",
+			ret);
+		return ret;
+	}
+
+	usleep_range(1000, 2000);
+	cci_log_tlmm_levels(cci, "CCI pads in GPIO-input probe state");
+
+	ret = pinctrl_select_state(cci->pinctrl, cci->pins_default);
+	if (ret) {
+		dev_err(cci->dev, "failed to restore CCI pinmux: %d\n", ret);
+		return ret;
+	}
+
+	cci_log_tlmm_levels(cci, "CCI pads after restoring CCI mux");
+	return 0;
+}
+
+static void cci_log_camera_gpios(struct cci *cci);
+
+static void cci_gpio_idle_sample_work(struct work_struct *work)
+{
+	struct cci *cci = container_of(to_delayed_work(work), struct cci,
+					       gpio_idle_sample_work);
+	int ret;
+
+	dev_info(cci->dev, "sampling CCI pads after sensor power-down\n");
+	ret = cci_probe_gpio_input_levels(cci);
+	cci_log_camera_gpios(cci);
+	if (ret)
+		dev_warn(cci->dev, "post-power-down GPIO sample failed: %d\n", ret);
+}
+
+static void cci_cancel_gpio_idle_sample(void *data)
+{
+	struct cci *cci = data;
+
+	cancel_delayed_work_sync(&cci->gpio_idle_sample_work);
+}
+
+static void cci_log_camera_gpios(struct cci *cci)
+{
+	static const struct {
+		unsigned int gpio;
+		u32 ctl_reg;
+		u32 io_reg;
+	} gpios[] = {
+		{ 34, TLMM_GPIO34_CTL_REG, TLMM_GPIO34_IO_REG },
+		{ 43, TLMM_GPIO43_CTL_REG, TLMM_GPIO43_IO_REG },
+		{ 58, TLMM_GPIO58_CTL_REG, TLMM_GPIO58_IO_REG },
+		{ 93, TLMM_GPIO93_CTL_REG, TLMM_GPIO93_IO_REG },
+	};
+	unsigned int i;
+
+	if (!cci->tlmm_base)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(gpios); i++) {
+		u32 ctl = readl(cci->tlmm_base + gpios[i].ctl_reg);
+		u32 io = readl(cci->tlmm_base + gpios[i].io_reg);
+
+		dev_err(cci->dev,
+			"camera GPIO%u raw: ctl=%#x io=%#x oe=%u mux=%u pull=%u input=%u output=%u\n",
+			gpios[i].gpio, ctl, io, (unsigned int)!!(ctl & BIT(9)),
+			(unsigned int)((ctl >> 2) & 0x7),
+			(unsigned int)(ctl & 0x3),
+			(unsigned int)!!(io & BIT(0)),
+			(unsigned int)!!(io & BIT(1)));
+	}
+}
