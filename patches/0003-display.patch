+static int dpu_encoder_wait_dsi_blank(void *data)
+{
+	struct dpu_encoder_phys *phys = data;
+	const struct drm_display_mode *mode;
+	u32 line, front_porch;
+
+	if (!phys || !phys->ops.get_line_count)
+		return -EINVAL;
+	mode = &phys->cached_mode;
+	front_porch = mode->vtotal - mode->vsync_start + mode->vdisplay;
+
+	return read_poll_timeout_atomic(phys->ops.get_line_count, line,
+			line >= front_porch && line < mode->vtotal,
+			1, 50000, false, phys);
+}
