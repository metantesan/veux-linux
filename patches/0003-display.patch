+static void dsi_7nm_k6s_stock_timing(struct msm_dsi_phy *phy,
+				  const struct msm_dsi_phy_clk_request *clk_req)
+{
+	struct msm_dsi_dphy_timing *timing = &phy->timing;
+	struct device_node *panel;
+	bool available;
+
+	/* Captured K6S table is for the stock 1.1 Gbit/s D-PHY mode only. */
+	if (phy->cfg != &dsi_phy_7nm_6375_cfgs || phy->cphy_mode ||
+	    clk_req->bitclk_rate < 1099000000UL ||
+	    clk_req->bitclk_rate > 1101000000UL)
+		return;
+
+	panel = of_find_compatible_node(NULL, NULL, "xiaomi,k6s-38-0c-0a");
+	available = panel && of_device_is_available(panel);
