+static u32 dpu_encoder_dsc_initial_line_calc_sm6375(struct drm_dsc_config *dsc,
+						 u32 enc_ip_width)
+{
+	u32 bpp = drm_dsc_get_bpp_int(dsc);
+	u32 soft_slices = enc_ip_width / dsc->slice_width;
+	u32 chunk_bits = dsc->slice_chunk_size * 8;
+	u32 input_latency, output_latency, extra_bits, total_pixels;
+
+	/*
+	 * SM6375's DSC core has a 64-bit output buffer, a maximum component
+	 * depth of 10 bits and a 48-bit mux word. Account for the output
+	 * buffer and the complete multi-slice latency, as the stock driver
+	 * does, before starting the video stream. The older 48-bit model
+	 * below underestimates this latency for the two-slice K6S panel.
+	 */
+	input_latency = 28 + 3 * (4 * (10 + 1) + 48 - 1 + 2) * soft_slices;
+	output_latency = DIV_ROUND_UP(9 * 64 + 48, bpp) + 1;
+	extra_bits = soft_slices > 1 ? chunk_bits :
+		((64 - bpp) * chunk_bits) >> 6;
+	total_pixels = dsc->initial_xmit_delay + input_latency +
+		output_latency + DIV_ROUND_UP(extra_bits, bpp);
+
+	return DIV_ROUND_UP(total_pixels, dsc->slice_width);
+}
