 		priv->gpu = adreno_load_gpu(dev);
+	mutex_unlock(&gpu_init_lock);
+}
+
+int msm_gpu_init_once(struct drm_device *dev)
+{
+	struct msm_drm_private *priv = dev->dev_private;
+	int ret;
+
+	if (!gpu_manual_init)
+		return -EOPNOTSUPP;
 
-	mutex_unlock(&init_lock);
+	mutex_lock(&gpu_init_lock);
+	if (priv->gpu_init_attempted) {
+		ret = -EALREADY;
+		goto out;
+	}
+	if (!priv->gpu_pdev) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/* Consume before entering hardware code; no implicit retry after failure. */
+	priv->gpu_init_attempted = true;
+	dev_info(dev->dev, "GPU-DIAG manual initialization begin\n");
+	priv->gpu = adreno_load_gpu(dev);
+	ret = priv->gpu ? 0 : -EIO;
+	dev_info(dev->dev, "GPU-DIAG manual initialization end: %d\n", ret);
+out:
+	mutex_unlock(&gpu_init_lock);
+	return ret;
