+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/xiaomi,k6s-38-0c-0a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi K6S 38/0c/0a 1080x2400 DSC AMOLED panel
+
+maintainers:
+  - hikari <me@metantesan.com>
+
+description: |
+  Four-lane video-mode DSI panel with DSC 1.1. This local bring-up binding
+  describes bootloader-powered takeover only. Panel supplies, reset and
+  enable controls must be added when full power sequencing is implemented.
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,k6s-38-0c-0a
+
+  reg:
+    maxItems: 1
+
+  port: true
+
+required:
+  - compatible
+  - reg
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "xiaomi,k6s-38-0c-0a";
+            reg = <0>;
+
+            port {
+                panel_in: endpoint {
+                    remote-endpoint = <&dsi_out>;
+                };
+            };
+        };
+    };
diff --git a/drivers/gpu/drm/panel/panel-xiaomi-k6s.c b/drivers/gpu/drm/panel/panel-xiaomi-k6s.c
new file mode 100644
index 000000000..6b73c40f1
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-xiaomi-k6s.c
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Xiaomi K6S 38/0c/0a. Commands/timing: Xiaomi downstream m17 K6S DTS.
+ * Experimental bootloader-powered takeover: panel rails and enable are
+ * deliberately not controlled until their complete power sequence is verified.
+ */
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <video/mipi_display.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+
+struct xiaomi_k6s {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	bool initialized;
+	struct drm_dsc_config dsc;
+};
+
+static struct xiaomi_k6s *to_k6s(struct drm_panel *panel)
+{
+	return container_of(panel, struct xiaomi_k6s, panel);
+}
+
+/* Vendor commands use long packets even when their payload is two bytes. */
+static void xiaomi_k6s_dcs_long_multi(struct mipi_dsi_multi_context *ctx,
+				    const void *data, size_t len)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct mipi_dsi_msg msg = {
+		.channel = dsi->channel,
+		.type = MIPI_DSI_DCS_LONG_WRITE,
+		.tx_buf = data,
+		.tx_len = len,
+	};
+	ssize_t ret;
+
+	if (ctx->accum_err)
+		return;
+	if (dsi->mode_flags & MIPI_DSI_MODE_LPM)
+		msg.flags |= MIPI_DSI_MSG_USE_LPM;
+	if (!dsi->host->ops || !dsi->host->ops->transfer) {
+		ctx->accum_err = -EOPNOTSUPP;
+		return;
+	}
+
+	ret = dsi->host->ops->transfer(dsi->host, &msg);
+	if (ret < 0) {
+		dev_err(&dsi->dev, "vendor command %#x failed: %zd\n",
+			*(const u8 *)data, ret);
+		ctx->accum_err = ret;
+	}
+}
+
+#define xiaomi_k6s_dcs_long_seq_multi(ctx, seq...) do { \
+	static const u8 data[] = { seq }; \
+	xiaomi_k6s_dcs_long_multi(ctx, data, ARRAY_SIZE(data)); \
+} while (0)
+
+/* Preserve the vendor initialization payload; the standard PPS follows on. */
+static const u8 xiaomi_k6s_vendor_pps[] = {
+	0x9e, 0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09, 0x60, 0x04, 0x38, 0x00,
+	0x28, 0x02, 0x1c, 0x02, 0x1c, 0x02, 0x00, 0x02, 0x0e, 0x00, 0x20, 0x03,
+	0xdd, 0x00, 0x07, 0x00, 0x0c, 0x02, 0x77, 0x02, 0x8b, 0x18, 0x00, 0x10,
+	0xf0, 0x03, 0x0c, 0x20, 0x00, 0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a,
+	0x38, 0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b, 0x7d, 0x7e, 0x01,
+	0x02, 0x01, 0x00, 0x09, 0x40, 0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19,
+	0xf8, 0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6, 0x2b, 0x34, 0x2b,
+	0x74, 0x3b, 0x74, 0x6b, 0xf4, 0x00,
+};
+
+static void xiaomi_k6s_read_status(struct xiaomi_k6s *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	u8 id[3] = { 0 }, power = 0, format = 0;
+	ssize_t id_ret;
+	int power_ret, format_ret;
+
+	/* Bounded standard DCS reads, while command transport is still idle. */
+	id_ret = mipi_dsi_dcs_read(dsi, MIPI_DCS_GET_DISPLAY_ID, id, sizeof(id));
+	power_ret = mipi_dsi_dcs_get_power_mode(dsi, &power);
+	format_ret = mipi_dsi_dcs_get_pixel_format(dsi, &format);
+	dev_info(&dsi->dev,
+		 "panel readback: id_ret=%zd id=%02x%02x%02x power_ret=%d power=%#x format_ret=%d format=%#x\n",
+		 id_ret, id[0], id[1], id[2], power_ret, power,
+		 format_ret, format);
+}
+
+static void xiaomi_k6s_finish_init(struct xiaomi_k6s *ctx,
+				   struct mipi_dsi_multi_context *dsi_ctx)
+{
+	struct drm_dsc_picture_parameter_set pps;
+
+	/* Downstream completes on, selects 120 Hz, then sends packet type 0x0a. */
+	mipi_dsi_msleep(dsi_ctx, 100);
+	mipi_dsi_dcs_set_display_on_multi(dsi_ctx);
+	xiaomi_k6s_dcs_long_seq_multi(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(dsi_ctx, 0x60, 0x01);
+	xiaomi_k6s_dcs_long_seq_multi(dsi_ctx, 0xf7, 0x0b);
+	xiaomi_k6s_dcs_long_seq_multi(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	if (dsi_ctx->accum_err)
+		return;
+
+	if (ctx->dsc.pic_width != 1080 || ctx->dsc.pic_height != 2400 ||
+	    !ctx->dsc.slice_chunk_size) {
+		dsi_ctx->accum_err = -EINVAL;
+		dev_err(&ctx->dsi->dev, "host DSC parameters are not ready\n");
+		return;
+	}
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(dsi_ctx, &pps);
+	/* Keep brightness zero until the host confirms its first video frame. */
+	if (!dsi_ctx->accum_err)
+		xiaomi_k6s_read_status(ctx);
+	ctx->initialized = !dsi_ctx->accum_err;
+	if (ctx->initialized)
+		dev_info(&ctx->dsi->dev,
+			 "panel on and PPS complete: %ux%u, slice %ux%u, two slices/packet\n",
+			 ctx->dsc.pic_width, ctx->dsc.pic_height,
+			 ctx->dsc.slice_width, ctx->dsc.slice_height);
+}
+
+static int xiaomi_k6s_prepare(struct drm_panel *panel)
+{
+	struct xiaomi_k6s *ctx = to_k6s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->initialized = false;
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x11);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb2, 0x01, 0x31);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xdf, 0x09, 0x30, 0x95, 0x46, 0xe9);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0x9d, 0x01);
+	xiaomi_k6s_dcs_long_multi(&dsi_ctx, xiaomi_k6s_vendor_pps,
+				      sizeof(xiaomi_k6s_vendor_pps));
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0x60, 0x21);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf7, 0x0b);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x15, 0xf6);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x28, 0xf6);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x3b, 0xf6);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf6, 0xf0);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0a, 0xf4);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf4, 0x98);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x11, 0xf4);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf4, 0xee);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x18, 0xb2);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb2, 0x1c);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x11, 0xfe);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xfe, 0x00);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0d, 0xb2);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb2, 0x20);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x0c, 0xb2);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb2, 0x30);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf7, 0x0b);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xfc, 0x5a, 0x5a);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xe1, 0x93);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x06, 0xf4);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf4, 0x1f);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0xfc, 0xa5, 0xa5);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0x53, 0x20);
+	xiaomi_k6s_dcs_long_seq_multi(&dsi_ctx, 0x51, 0x00, 0x00);
+	xiaomi_k6s_finish_init(ctx, &dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+	return dsi_ctx.accum_err;
+}
+
+static int xiaomi_k6s_enable(struct drm_panel *panel)
+{
+	struct xiaomi_k6s *ctx = to_k6s(panel);
+
+	/* No command DMA here: video is enabled but DPU has not kicked off yet. */
+	return ctx->initialized ? 0 : -EIO;
+}
+
+static int xiaomi_k6s_disable(struct drm_panel *panel)
+{
+	struct xiaomi_k6s *ctx = to_k6s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	if (!ctx->initialized)
+		return 0;
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	return dsi_ctx.accum_err;
+}
+
+static int xiaomi_k6s_unprepare(struct drm_panel *panel)
+{
+	struct xiaomi_k6s *ctx = to_k6s(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->initialized = false;
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode xiaomi_k6s_mode = {
+	.clock = 393400,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 120,
+	.hsync_end = 1080 + 120 + 28,
+	.htotal = 1080 + 120 + 28 + 120,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 20,
+	.vsync_end = 2400 + 20 + 2,
+	.vtotal = 2400 + 20 + 2 + 10,
+	.width_mm = 70,
+	.height_mm = 155,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int xiaomi_k6s_get_modes(struct drm_panel *panel,
+							  struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &xiaomi_k6s_mode);
+}
+
+static const struct drm_panel_funcs xiaomi_k6s_funcs = {
+	.prepare = xiaomi_k6s_prepare,
+	.enable = xiaomi_k6s_enable,
+	.disable = xiaomi_k6s_disable,
+	.unprepare = xiaomi_k6s_unprepare,
+	.get_modes = xiaomi_k6s_get_modes,
+};
+
+static int xiaomi_k6s_probe(struct mipi_dsi_device *dsi)
+{
+	struct xiaomi_k6s *ctx;
+	struct drm_dsc_config *dsc;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(&dsi->dev, struct xiaomi_k6s, panel,
+							   &xiaomi_k6s_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->dsi = dsi;
+	dsc = &ctx->dsc;
+	dsc->dsc_version_major = 1;
+	dsc->dsc_version_minor = 1;
+	dsc->slice_height = 20;
+	dsc->slice_width = 540;
+	dsc->slice_count = 2;
+	dsc->bits_per_component = 8;
+	dsc->bits_per_pixel = 8 << 4;
+	dsc->block_pred_enable = true;
+	dsi->dsc = dsc;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_DSC_ALL_SLICES_IN_PKT;
+	ctx->panel.prepare_prev_first = true;
+	mipi_dsi_set_drvdata(dsi, ctx);
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret)
+		drm_panel_remove(&ctx->panel);
+	return ret;
+}
+
+static void xiaomi_k6s_remove(struct mipi_dsi_device *dsi)
+{
+	struct xiaomi_k6s *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret)
+		dev_err(&dsi->dev, "DSI detach failed: %d\n", ret);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id xiaomi_k6s_of_match[] = {
+	{ .compatible = "xiaomi,k6s-38-0c-0a" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, xiaomi_k6s_of_match);
+
+static struct mipi_dsi_driver xiaomi_k6s_driver = {
+	.probe = xiaomi_k6s_probe,
+	.remove = xiaomi_k6s_remove,
+	.driver = {
+		.name = "panel-xiaomi-k6s",
+		.of_match_table = xiaomi_k6s_of_match,
+	},
+};
+module_mipi_dsi_driver(xiaomi_k6s_driver);
+
+MODULE_DESCRIPTION("Xiaomi K6S 38/0c/0a experimental DSC panel");
+MODULE_LICENSE("GPL");
