+static void dsi_mgr_bridge_enable(struct drm_bridge *bridge,
+				  struct drm_atomic_commit *commit)
+{
+	struct msm_dsi *dsi = dsi_mgr_get_dsi(dsi_mgr_bridge_get_id(bridge));
+	struct drm_panel *panel;
+
+	if (!dsi_mgr_bridge_defer_video(bridge))
+		return;
+
+	panel = of_drm_find_panel(dsi->next_bridge->of_node);
+	if (IS_ERR(panel) || !panel->prepared) {
+		dev_err(&dsi->pdev->dev, "K6S prepare failed; video remains stopped\n");
+		return;
+	}
+
+	dsi->video_start_pending = true;
+	dev_info(&dsi->pdev->dev, "K6S waiting for DPU kickoff\n");
+}
+
+static void dsi_mgr_bridge_disable(struct drm_bridge *bridge,
+				   struct drm_atomic_commit *commit)
+{
+	struct msm_dsi *dsi = dsi_mgr_get_dsi(dsi_mgr_bridge_get_id(bridge));
+
+	/* Stop video before panel unprepare sends sleep-in. Keep clocks/IRQ on. */
+	if (dsi_mgr_bridge_defer_video(bridge)) {
+		dsi->video_start_pending = false;
+		msm_dsi_host_disable(dsi->host);
+	}
+}
+
+/* K6S must not feed video until the DPU timing engine is producing data. */
+void msm_dsi_post_kickoff(struct msm_dsi *dsi,
+			  int (*wait_for_blank)(void *), void *data)
+{
+	struct mipi_dsi_device *panel;
+	const u8 brightness[] = { 0x51, 0x01, 0x00 };
+	int ret;
+
+	if (!dsi || !dsi->video_start_pending)
+		return;
+
+	dsi->video_start_pending = false;
+	ret = msm_dsi_host_start_video(dsi->host, wait_for_blank, data);
+	if (ret) {
+		dev_err(&dsi->pdev->dev, "K6S video startup failed: %d; panel stays dark\n", ret);
+		return;
+	}
+
+	panel = of_find_mipi_dsi_device_by_node(dsi->next_bridge->of_node);
+	if (!panel)
+		return;
+	ret = mipi_dsi_dcs_write_buffer(panel, brightness, sizeof(brightness));
+	put_device(&panel->dev);
+	if (ret < 0)
+		dev_err(&dsi->pdev->dev, "K6S brightness failed: %d\n", ret);
+	else
+		dev_info(&dsi->pdev->dev, "K6S valid video before backlight\n");
+}
