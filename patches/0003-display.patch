+/* Start K6S in blanking with a clean FIFO, after DPU kickoff. */
+int msm_dsi_host_start_video(struct mipi_dsi_host *host,
+			     int (*wait_for_blank)(void *), void *data)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	u32 ctrl, clocks;
+	int ret;
+
+	if (!msm_host->power_on || msm_host->enabled || !wait_for_blank ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO))
+		return -EINVAL;
+
+	mutex_lock(&msm_host->dev_mutex);
+	mutex_lock(&msm_host->cmd_mutex);
+	ctrl = dsi_read(msm_host, REG_DSI_CTRL);
+	clocks = dsi_read(msm_host, REG_DSI_CLK_CTRL);
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 0);
+	/* All three engines must be stopped before forcing dynamic clocks. */
+	dsi_write(msm_host, REG_DSI_CTRL,
+		  ctrl & ~(DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN | DSI_CTRL_CMD_MODE_EN));
+	dsi_read(msm_host, REG_DSI_CTRL);
+	dsi_write(msm_host, REG_DSI_CLK_CTRL,
+		  clocks | DSI_CLK_CTRL_ENABLE_CLKS | BIT(8) | BIT(9) | BIT(11) | BIT(21));
+	dsi_read(msm_host, REG_DSI_CLK_CTRL);
+	dsi_write(msm_host, REG_DSI_RESET, 1);
+	dsi_read(msm_host, REG_DSI_RESET);
+	usleep_range(1000, 1100);
+	dsi_write(msm_host, REG_DSI_RESET, 0);
+	dsi_read(msm_host, REG_DSI_RESET);
+	dsi_write(msm_host, REG_DSI_CLK_CTRL, clocks);
+	dsi_read(msm_host, REG_DSI_CLK_CTRL);
+
+	reinit_completion(&msm_host->video_comp);
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 1);
+	ret = wait_for_blank(data);
+	if (!ret) {
+		dsi_write(msm_host, REG_DSI_CTRL,
+			  (ctrl | DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN) & ~DSI_CTRL_CMD_MODE_EN);
+		dsi_read(msm_host, REG_DSI_CTRL);
+		if (!wait_for_completion_timeout(&msm_host->video_comp,
+						 msecs_to_jiffies(70)))
+			ret = -ETIMEDOUT;
+	}
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_VIDEO_DONE, 0);
+	if (ret) {
+		dsi_write(msm_host, REG_DSI_CTRL,
+			  ctrl & ~(DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN | DSI_CTRL_CMD_MODE_EN));
+		dsi_read(msm_host, REG_DSI_CTRL);
+	} else {
+		msm_host->enabled = true;
+	}
+	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
+	mutex_unlock(&msm_host->cmd_mutex);
+	mutex_unlock(&msm_host->dev_mutex);
+	return ret;
+}
