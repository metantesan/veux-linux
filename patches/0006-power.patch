Subject: [PATCH 06/11] SYV690 charging driver

Part of the Linux 7.3 veux development snapshot. Apply in patches/series order.
Original source copyright and SPDX notices are retained.

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index b89ef40df..a50f415e6 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1202,4 +1202,41 @@ config MACSMC_POWER
 
 	  Say Y or M here if you have an Apple Silicon based Mac.
 
+config CHARGER_SYV690
+	tristate "Xiaomi veux SYV690 conservative USB charger"
+	depends on I2C && OF
+	select REGMAP_I2C
+	help
+	  Limited SYV690 revision 0 monitoring with no charger programming by
+	  default. A separate experimental control option uses the battery gauge
+	  for temperature policy. No fast-charge negotiation or OTG support.
+	  The device is polled rather than using a charger IRQ.
+
+config CHARGER_SYV690_CONTROL
+	bool "Enable experimental SYV690 charger programming"
+	depends on CHARGER_SYV690
+	help
+	  Allow the experimental charging profile to program the IC. The first
+	  control image caused a phone boot loop and its cause is unresolved.
+	  Leave disabled for monitor-only diagnostics with regmap writes blocked.
+	  Do not enable until the charger reset has been isolated on hardware.
+
+config CHARGER_SYV690_SWITCH
+	bool "Enable explicit SYV690 charge-bit diagnostic"
+	depends on CHARGER_SYV690 && !CHARGER_SYV690_CONTROL
+	help
+	  Expose an explicit charge enable/inhibit switch through sysfs while
+	  keeping boot, polling and power-management paths read-only. Only the
+	  charge-enable bit may be written. Re-enabling requires the inherited
+	  charging profile, a healthy gauge and unchanged conservative limits.
+
+config CHARGER_SYV690_PD_LIMIT
+	bool "Bound SYV690 input current to the fixed USB-PD contract"
+	depends on CHARGER_SYV690 && !CHARGER_SYV690_CONTROL && CHARGER_SYV690_SWITCH
+	help
+	  Allow the board driver to update only the SYV690 input-current field.
+	  Select 2 A only while TCPM reports an online 5 V PD contract with at
+	  least 2 A available and the battery/source checks pass; otherwise restore
+	  500 mA. Charge current, voltage and charge enable are left unchanged.
+
 endif # POWER_SUPPLY
