diff --git a/drivers/net/ipa/ipa_qmi.c b/drivers/net/ipa/ipa_qmi.c
index d771f3a71..9501d82fc 100644
--- a/drivers/net/ipa/ipa_qmi.c
+++ b/drivers/net/ipa/ipa_qmi.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/qrtr.h>
+#include <linux/of.h>
 #include <linux/string.h>
 #include <linux/types.h>
 
@@ -76,6 +77,45 @@
 
 #define QMI_INIT_DRIVER_TIMEOUT		60000	/* A minute in milliseconds */
 
+static bool ipa_qmi_holi(struct ipa *ipa)
+{
+	return of_device_is_compatible(ipa->dev->of_node, "qcom,sm6375-ipa");
+}
+
+/* The first host advertisement can precede a usable modem transport. Retry
+ * from the same server socket after the modem answers INIT_DRIVER.
+ */
+static int ipa_server_reannounce(struct ipa_qmi *ipa_qmi)
+{
+	struct qmi_handle *qmi = &ipa_qmi->server_handle;
+	struct sockaddr_qrtr local, dest;
+	struct qrtr_ctrl_pkt pkt = { };
+	struct msghdr msg = { };
+	struct kvec iv = { &pkt, sizeof(pkt) };
+	int ret;
+
+	mutex_lock(&qmi->sock_lock);
+	ret = kernel_getsockname(qmi->sock, (struct sockaddr *)&local);
+	if (ret < 0)
+		goto out;
+	dest = local;
+	dest.sq_port = QRTR_PORT_CTRL;
+	pkt.cmd = cpu_to_le32(QRTR_TYPE_NEW_SERVER);
+	pkt.server.service = cpu_to_le32(IPA_HOST_SERVICE_SVC_ID);
+	pkt.server.instance = cpu_to_le32(IPA_HOST_SVC_VERS |
+					IPA_HOST_SERVICE_INS_ID << 8);
+	pkt.server.node = cpu_to_le32(local.sq_node);
+	pkt.server.port = cpu_to_le32(local.sq_port);
+	msg.msg_name = &dest;
+	msg.msg_namelen = sizeof(dest);
+	ret = kernel_sendmsg(qmi->sock, &msg, &iv, 1, sizeof(pkt));
+	if (ret >= 0)
+		ret = 0;
+out:
+	mutex_unlock(&qmi->sock_lock);
+	return ret;
+}
+
 /* Send an INIT_COMPLETE indication message to the modem */
 static void ipa_server_init_complete(struct ipa_qmi *ipa_qmi)
 {
@@ -85,17 +125,24 @@ static void ipa_server_init_complete(struct ipa_qmi *ipa_qmi)
 	struct ipa_init_complete_ind ind = { };
 	int ret;
 
+	if (ipa_qmi_holi(ipa))
+		sq = &ipa_qmi->indication_sq;
+
 	ind.status.result = QMI_RESULT_SUCCESS_V01;
 	ind.status.error = QMI_ERR_NONE_V01;
 
 	ret = qmi_send_indication(qmi, sq, IPA_QMI_INIT_COMPLETE,
 				   IPA_QMI_INIT_COMPLETE_IND_SZ,
 				   ipa_init_complete_ind_ei, &ind);
-	if (ret)
+	if (ret) {
 		dev_err(ipa->dev,
 			"error %d sending init complete indication\n", ret);
-	else
+	} else {
 		ipa_qmi->indication_sent = true;
+		if (ipa_qmi_holi(ipa))
+			dev_info(ipa->dev, "Holi IPA AP completion sent to %u:%u\n",
+				 sq->sq_node, sq->sq_port);
+	}
 }
 
 /* If requested (and not already sent) send the INIT_COMPLETE indication */
@@ -121,11 +168,20 @@ static void ipa_qmi_indication(struct ipa_qmi *ipa_qmi)
  */
 static void ipa_qmi_ready(struct ipa_qmi *ipa_qmi)
 {
-	struct ipa *ipa;
+	struct ipa *ipa = container_of(ipa_qmi, struct ipa, qmi);
+	bool uc_ready = ipa_qmi->uc_ready;
 	int ret;
 
+	/* Holi's AP-loaded microcontroller reports readiness through its IRQ.
+	 * Its modem can omit DRIVER_INIT_COMPLETE when that firmware is already
+	 * loaded. The downstream driver gates on the successful INIT_DRIVER
+	 * exchange and this hardware-ready event, not the optional QMI request.
+	 */
+	if (ipa_qmi_holi(ipa))
+		uc_ready |= READ_ONCE(ipa->uc_loaded);
+
 	/* We aren't ready until the modem and microcontroller are */
-	if (!ipa_qmi->modem_ready || !ipa_qmi->uc_ready)
+	if (!ipa_qmi->modem_ready || !uc_ready)
 		return;
 
 	/* Send the indication message if it was requested */
@@ -141,10 +197,11 @@ static void ipa_qmi_ready(struct ipa_qmi *ipa_qmi)
 	}
 
 	/* We're ready.  Start up normal operation */
-	ipa = container_of(ipa_qmi, struct ipa, qmi);
 	ret = ipa_modem_start(ipa);
 	if (ret)
 		dev_err(ipa->dev, "error %d starting modem\n", ret);
+	else if (ipa_qmi_holi(ipa))
+		dev_info(ipa->dev, "Holi IPA QMI handshake complete\n");
 }
 
 /* All QMI clients from the modem node are gone (modem shut down or crashed). */
@@ -156,6 +213,7 @@ static void ipa_server_bye(struct qmi_handle *qmi, unsigned int node)
 
 	/* The modem client and server go away at the same time */
 	memset(&ipa_qmi->modem_sq, 0, sizeof(ipa_qmi->modem_sq));
+	memset(&ipa_qmi->indication_sq, 0, sizeof(ipa_qmi->indication_sq));
 
 	/* initial_boot doesn't change when modem reboots */
 	/* uc_ready doesn't change when modem reboots */
@@ -185,6 +243,11 @@ static void ipa_server_indication_register(struct qmi_handle *qmi,
 	ipa_qmi = container_of(qmi, struct ipa_qmi, server_handle);
 	ipa = container_of(ipa_qmi, struct ipa, qmi);
 
+	ipa_qmi->indication_sq = *sq;
+	if (ipa_qmi_holi(ipa))
+		dev_info(ipa->dev, "Holi IPA indication client %u:%u\n",
+			 sq->sq_node, sq->sq_port);
+
 	rsp.rsp.result = QMI_RESULT_SUCCESS_V01;
 	rsp.rsp.error = QMI_ERR_NONE_V01;
 
@@ -222,6 +285,8 @@ static void ipa_server_driver_init_complete(struct qmi_handle *qmi,
 				ipa_driver_init_complete_rsp_ei, &rsp);
 	if (!ret) {
 		ipa_qmi->uc_ready = true;
+		if (ipa_qmi_holi(ipa))
+			dev_info(ipa->dev, "Holi IPA modem completion received\n");
 		ipa_qmi_ready(ipa_qmi);		/* We might be ready now */
 	} else {
 		dev_err(ipa->dev,
@@ -253,7 +318,16 @@ static void ipa_client_init_driver(struct qmi_handle *qmi,
 				   struct sockaddr_qrtr *sq,
 				   struct qmi_txn *txn, const void *decoded)
 {
+	const struct ipa_init_modem_driver_rsp *rsp = decoded;
+	struct ipa_qmi *ipa_qmi = container_of(qmi, struct ipa_qmi, client_handle);
+	struct ipa *ipa = container_of(ipa_qmi, struct ipa, qmi);
+
 	txn->result = 0;	/* IPA_QMI_INIT_DRIVER request was successful */
+	if (ipa_qmi_holi(ipa) && rsp->rsp.result != QMI_RESULT_SUCCESS_V01) {
+		dev_err(ipa->dev, "Holi IPA modem rejected parameters: result=%u error=%u\n",
+			rsp->rsp.result, rsp->rsp.error);
+		txn->result = -EREMOTEIO;
+	}
 	complete(&txn->completion);
 }
 
@@ -433,6 +507,12 @@ static void ipa_client_init_driver_work(struct work_struct *work)
 
 	if (!ret) {
 		ipa_qmi->modem_ready = true;
+		if (ipa_qmi_holi(ipa)) {
+			dev_info(dev, "Holi IPA modem parameters accepted\n");
+			ret = ipa_server_reannounce(ipa_qmi);
+			if (ret)
+				dev_err(dev, "Holi IPA service reannouncement failed: %d\n", ret);
+		}
 		ipa_qmi_ready(ipa_qmi);		/* We might be ready now */
 	} else {
 		/* If any error occurs we need to cancel the transaction */
