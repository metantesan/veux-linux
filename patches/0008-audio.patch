diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
index dbc5795b9..68ff988ba 100644
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -1485,22 +1485,33 @@ static int va_macro_validate_dmic_sample_rate(u32 dmic_sample_rate,
 static int va_macro_set_lpass_codec_version(struct va_macro *va)
 {
 	int version = LPASS_CODEC_VERSION_UNKNOWN;
-	u32 maj, min, step;
+	int ret;
+	u32 maj, min, step, features;
 	u32 val;
 
-	regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_0, &val);
+	ret = regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_0, &val);
+	if (ret)
+		return ret;
 	maj = FIELD_GET(CORE_ID_0_REV_MAJ, val);
 
-	regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_1, &val);
+	ret = regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_1, &val);
+	if (ret)
+		return ret;
+	features = val & 0xf;
 	if (!FIELD_GET(CORE_ID_1_HAS_VAMACRO, val)) {
 		dev_err(va->dev, "This is not a VA macro instance\n");
 		return -ENODEV;
 	}
 
-	regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_2, &val);
+	ret = regmap_read(va->regmap, CDC_VA_TOP_CSR_CORE_ID_2, &val);
+	if (ret)
+		return ret;
 	min = FIELD_GET(CORE_ID_2_REV_MIN, val);
 	step = FIELD_GET(CORE_ID_2_REV_STEP, val);
 
+	dev_info(va->dev, "VA revision %u.%u.%u, macro features %#x\n",
+		 maj, min, step, features);
+
 	if (maj == 1) {
 		version = LPASS_CODEC_VERSION_2_0;
 	} else if (maj == 2) {
@@ -1508,6 +1519,11 @@ static int va_macro_set_lpass_codec_version(struct va_macro *va)
 		case 0:
 			version = LPASS_CODEC_VERSION_2_0;
 			break;
+		case 2:
+			/* Holi 2.2.0 is the RX/TX/VA-only Bolero 2.1 layout. */
+			if (features == 0xe && step == 0)
+				version = LPASS_CODEC_VERSION_2_1;
+			break;
 		case 5:
 			version = LPASS_CODEC_VERSION_2_5;
 			break;
