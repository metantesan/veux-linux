diff --git a/sound/soc/codecs/wcd937x.c b/sound/soc/codecs/wcd937x.c
index 0dd05604f..6ab8de977 100644
--- a/sound/soc/codecs/wcd937x.c
+++ b/sound/soc/codecs/wcd937x.c
@@ -2476,16 +2476,37 @@ static const struct irq_domain_ops wcd_domain_ops = {
 	.map = wcd_irq_chip_map,
 };
 
+static void wcd937x_irq_domain_remove(void *data)
+{
+	struct irq_domain *domain = data;
+
+	irq_dispose_mapping(irq_find_mapping(domain, 0));
+	irq_domain_remove(domain);
+}
+
 static int wcd937x_irq_init(struct wcd937x_priv *wcd, struct device *dev)
 {
+	unsigned int irq;
+	int ret;
+
 	wcd->virq = irq_domain_create_linear(NULL, 1, &wcd_domain_ops, NULL);
 	if (!(wcd->virq)) {
 		dev_err(dev, "%s: Failed to add IRQ domain\n", __func__);
 		return -EINVAL;
 	}
 
-	return devm_regmap_add_irq_chip(dev, wcd->regmap,
-					irq_create_mapping(wcd->virq, 0),
+	irq = irq_create_mapping(wcd->virq, 0);
+	if (!irq) {
+		irq_domain_remove(wcd->virq);
+		return -ENOMEM;
+	}
+
+	/* Release the regmap IRQ chip before its parent mapping and domain. */
+	ret = devm_add_action_or_reset(dev, wcd937x_irq_domain_remove, wcd->virq);
+	if (ret)
+		return ret;
+
+	return devm_regmap_add_irq_chip(dev, wcd->regmap, irq,
 					IRQF_ONESHOT, 0, &wcd937x_regmap_irq_chip,
 					&wcd->irq_chip);
 }
diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index f0ff1350e..299621945 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -392,6 +392,7 @@ struct q6afe {
 	struct device *dev;
 	struct q6core_svc_api_info ainfo;
 	struct mutex lock;
+	u32 vote_handle;
 	struct aprv2_ibasic_rsp_result_t result;
 	wait_queue_head_t wait;
 	struct list_head port_list;
@@ -664,6 +665,10 @@ struct afe_cmd_remote_lpass_core_hw_vote_request {
 	char client_name[8];
 } __packed;
 
+struct afe_cmd_rsp_remote_lpass_core_hw_vote_request {
+	u32 client_handle;
+} __packed;
+
 struct afe_cmd_remote_lpass_core_hw_devote_request {
 	uint32_t  hw_block_id;
 	uint32_t client_handle;
@@ -1017,11 +1022,25 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 	res = data->payload;
 	switch (hdr->opcode) {
 	case APR_BASIC_RSP_RESULT: {
+		if (data->payload_size < sizeof(*res))
+			return -EINVAL;
 		if (res->status) {
 			dev_err(afe->dev, "cmd = 0x%x returned error = 0x%x\n",
 				res->opcode, res->status);
 		}
 		switch (res->opcode) {
+		case AFE_CMD_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
+			/* Success has a separate response carrying the client handle. */
+			if (!res->status)
+				break;
+			afe->result.opcode = AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST;
+			afe->result.status = res->status;
+			wake_up(&afe->wait);
+			break;
+		case AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST:
+			afe->result = *res;
+			wake_up(&afe->wait);
+			break;
 		case AFE_PORT_CMD_SET_PARAM_V2:
 		case AFE_PORT_CMD_DEVICE_STOP:
 		case AFE_PORT_CMD_DEVICE_START:
@@ -1042,11 +1061,17 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 		}
 	}
 		break;
-	case AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
+	case AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST: {
+		const struct afe_cmd_rsp_remote_lpass_core_hw_vote_request *rsp = data->payload;
+
+		if (data->payload_size < sizeof(*rsp))
+			return -EINVAL;
+		afe->vote_handle = rsp->client_handle;
 		afe->result.opcode = hdr->opcode;
-		afe->result.status = res->status;
+		afe->result.status = 0;
 		wake_up(&afe->wait);
 		break;
+	}
 	default:
 		break;
 	}
@@ -1070,14 +1095,17 @@ int q6afe_get_port_id(int index)
 }
 EXPORT_SYMBOL_GPL(q6afe_get_port_id);
 
-static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
-			    struct q6afe_port *port, uint32_t rsp_opcode)
+static int afe_apr_send_pkt_with_handle(struct q6afe *afe, struct apr_pkt *pkt,
+				      struct q6afe_port *port, uint32_t rsp_opcode,
+				      u32 *client_handle)
 {
 	wait_queue_head_t *wait;
 	struct aprv2_ibasic_rsp_result_t *result;
 	int ret;
 
 	mutex_lock(&afe->lock);
+	if (client_handle)
+		afe->vote_handle = 0;
 	if (port) {
 		wait = &port->wait;
 		result = &port->result;
@@ -1109,11 +1137,23 @@ static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
 	}
 
 err:
+	if (!ret && client_handle) {
+		if (!afe->vote_handle)
+			ret = -EINVAL;
+		else
+			*client_handle = afe->vote_handle;
+	}
 	mutex_unlock(&afe->lock);
 
 	return ret;
 }
 
+static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
+			  struct q6afe_port *port, uint32_t rsp_opcode)
+{
+	return afe_apr_send_pkt_with_handle(afe, pkt, port, rsp_opcode, NULL);
+}
+
 static int q6afe_set_param(struct q6afe *afe, struct q6afe_port *port,
 			   void *data, int param_id, int module_id, int psize,
 			   int token)
@@ -1915,7 +1955,10 @@ int q6afe_unvote_lpass_core_hw(struct device *dev, uint32_t hw_block_id,
 	vote_cfg->hw_block_id = hw_block_id;
 	vote_cfg->client_handle = client_handle;
 
-	ret = apr_send_pkt(afe->apr, pkt);
+	if (!client_handle)
+		return -EINVAL;
+	ret = afe_apr_send_pkt(afe, pkt, NULL,
+			       AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST);
 	if (ret < 0)
 		dev_err(afe->dev, "AFE failed to unvote (%d)\n", hw_block_id);
 
@@ -1951,8 +1994,11 @@ int q6afe_vote_lpass_core_hw(struct device *dev, uint32_t hw_block_id,
 	strscpy(vote_cfg->client_name, client_name,
 			sizeof(vote_cfg->client_name));
 
-	ret = afe_apr_send_pkt(afe, pkt, NULL,
-			       AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST);
+	if (!client_handle)
+		return -EINVAL;
+	*client_handle = 0;
+	ret = afe_apr_send_pkt_with_handle(afe, pkt, NULL,
+			AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST, client_handle);
 	if (ret)
 		dev_err(afe->dev, "AFE failed to vote (%d)\n", hw_block_id);
 
