+			};
+			data-pins {
+				pins = "gpio4", "gpio5";
+				function = "swr_rx_data";
+				drive-strength = <10>;
+				slew-rate = <1>;
+				bias-bus-hold;
+			};
+		};
+	};
+
+	lpass_audiocc: clock-controller@a6a9000 {
+		compatible = "qcom,sm6115-lpassaudiocc";
+		reg = <0 0x0a6a9000 0 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	lpasscc: clock-controller@a7ec000 {
+		compatible = "qcom,sm6115-lpasscc";
+		reg = <0 0x0a7ec000 0 0x1000>;
+		#clock-cells = <1>;
+		#reset-cells = <1>;
+	};
+
+	rxmacro: codec@a600000 {
+		compatible = "qcom,sm6115-lpass-rx-macro";
+		reg = <0 0x0a600000 0 0x1000>;
+		clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		clock-names = "mclk", "npl", "dcodec", "fsgen";
+		#clock-cells = <0>;
+		#sound-dai-cells = <1>;
+	};
+
+	txmacro: codec@a620000 {
+		compatible = "qcom,sm6115-lpass-tx-macro";
+		reg = <0 0x0a620000 0 0x1000>;
+		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&vamacro>;
+		clock-names = "mclk", "npl", "dcodec", "fsgen";
+		#clock-cells = <0>;
+		#sound-dai-cells = <1>;
+	};
+
+	swr_tx: soundwire@a740000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		reg = <0 0x0a740000 0 0x2000>;
+		interrupts-extended = <&mpm 5 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "core";
+		clocks = <&vamacro>;
+		clock-names = "iface";
+		resets = <&lpasscc LPASS_SWR_TX_CONFIG_CGCR>;
+		reset-names = "swr_audio_cgcr";
+		pinctrl-names = "default";
+		pinctrl-0 = <&swr_tx_default>;
+		qcom,ports-sinterval-low = /bits/ 8 <3 3 3 0>;
+		qcom,ports-offset1 = /bits/ 8 <0 1 2 0>;
+		qcom,ports-offset2 = /bits/ 8 <0 0 0 0>;
+		qcom,ports-block-pack-mode = /bits/ 8 <0xff 0xff 0xff 0xff>;
+		qcom,ports-lane-control = /bits/ 8 <1 0 0 0>;
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		wcd_tx: codec@0,3 {
+			compatible = "sdw20217010a00";
+			reg = <0 3>;
+			qcom,tx-port-mapping = <1 2 3 3>;
+			qcom,tx-channel-mapping = /bits/ 8 <1 1 2 4 1 2 3 4 1 2 3 4>;
+		};
+	};
+
+	swr_rx: soundwire@a610000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		/* The board uses all six outputs; its hardware input is unused. */
+		qcom,din-ports = <0>;
+		reg = <0 0x0a610000 0 0x2000>;
+		interrupts = <GIC_SPI 297 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "core";
+		clocks = <&rxmacro>;
+		clock-names = "iface";
+		resets = <&lpass_audiocc LPASS_AUDIO_SWR_RX_CGCR>;
+		reset-names = "swr_audio_cgcr";
+		pinctrl-names = "default";
+		pinctrl-0 = <&swr_rx_default>;
+		qcom,ports-sinterval = /bits/ 16 <3 31 31 7 0 399>;
+		qcom,ports-offset1 = /bits/ 8 <0 0 11 1 0 0>;
+		qcom,ports-offset2 = /bits/ 8 <0 0 11 0 0 0>;
+		qcom,ports-word-length = /bits/ 8 <1 7 4 0xff 0xff 15>;
+		qcom,ports-block-pack-mode = /bits/ 8 <0xff 0 1 0xff 0 0>;
+		qcom,ports-lane-control = /bits/ 8 <1 0 0 0 0 0>;
+		qcom,ports-hstart = /bits/ 8 <0xff 3 0xff 0xff 0xff 8>;
+		qcom,ports-hstop = /bits/ 8 <0xff 6 0xff 0xff 0xff 8>;
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		wcd_rx: codec@0,4 {
+			compatible = "sdw20217010a00";
+			reg = <0 4>;
+			qcom,rx-port-mapping = <1 2 3 4 5>;
+			qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
+		};
+	};
+};
+
+&soc {
+	/* Expose CSIPHY0/CSID0/TFE0 to V4L2.
+	 * Keep sensor nodes disabled until power and pin ownership are verified.
+	 * No ICC paths are requested, so do not stream.
+	 */
+	camss: camss@5c52000 {
+		compatible = "qcom,sm6375-camss";
+		reg = <0 0x05c52000 0 0x2000>,
+		      <0 0x05c6e000 0 0x1000>,
+		      <0 0x05c6f000 0 0x4000>;
+		reg-names = "csiphy0", "csid0", "vfe0";
+		interrupts = <GIC_SPI 72 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 210 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 211 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "csiphy0", "csid0", "vfe0";
+		clocks = <&gcc GCC_CAMSS_TOP_AHB_CLK>,
+			 <&gcc GCC_CAMERA_AHB_CLK>,
+			 <&gcc GCC_CAMSS_AXI_CLK>,
+			 <&gcc GCC_CAMSS_TFE_0_CSID_CLK>,
+			 <&gcc GCC_CAMSS_CPHY_0_CLK>,
+			 <&gcc GCC_CAMSS_CSI0PHYTIMER_CLK>,
+			 <&gcc GCC_CAMSS_TFE_0_CLK>,
+			 <&gcc GCC_CAMSS_TFE_0_CPHY_RX_CLK>,
+			 <&gcc GCC_CAMSS_NRT_AXI_CLK>,
+			 <&gcc GCC_CAMSS_RT_AXI_CLK>;
+		clock-names = "top_ahb", "ahb", "axi", "csi0", "csiphy0",
+			      "csiphy0_timer", "vfe0", "vfe0_cphy_rx",
+			      "camnoc_nrt_axi", "camnoc_rt_axi";
+		iommus = <&apps_smmu 0x800 0x400>;
+		power-domains = <&gcc CAMSS_TOP_GDSC>;
+		mipi-csi-vdd1-supply = <&pm6125_l7>;
+		mipi-csi-vdd2-supply = <&pm6125_l4>;
+		status = "okay";
+	};
+};
+
+&cci {
+	/* Probe the controller and register empty I2C adapters; no clients exist. */
+	qcom,tlmm = <&tlmm>;
+	pinctrl-names = "default", "sleep", "gpio-probe", "gpio-high";
+	pinctrl-0 = <&cci0_i2c0_default>;
+	pinctrl-1 = <&cci0_i2c0_sleep>;
+	pinctrl-2 = <&cci0_i2c0_gpio_probe>;
+	pinctrl-3 = <&veux_cci0_i2c0_gpio_high>;
+	status = "okay";
+};
+
+&cci_i2c0 {
+	/* One-shot identity probe only; no mode tables or CSI streaming. */
+	s5khm2_id_probe: camera@10 {
+		compatible = "xiaomi,veux-s5khm2-id-probe";
+		reg = <0x10>;
+		/* Android's cam_clk supply enables this GDSC before MCLK. */
+		power-domains = <&gcc CAMSS_TOP_GDSC>;
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		clock-names = "xclk";
+		vdig-supply = <&cam_main_vdig>;
+		reset-gpios = <&tlmm 34 GPIO_ACTIVE_LOW>;
+		vana-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;
+		vio-gpios = <&tlmm 93 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&veux_cam_mclk0_active &veux_cam_reset0_active>;
+		pinctrl-1 = <&veux_cam_mclk0_sleep &veux_cam_reset0_sleep>;
+	};
+};
