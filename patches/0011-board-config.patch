diff --git a/arch/arm64/boot/dts/qcom/sm6375-xiaomi-veux.dts b/arch/arm64/boot/dts/qcom/sm6375-xiaomi-veux.dts
new file mode 100644
index 000000000..3acde4e59
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6375-xiaomi-veux.dts
@@ -0,0 +1,1018 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Redmi Note 11 Pro 5G (veux): initial USB/netboot bring-up.
+ * Board wiring/carveouts: captured kernel/veux-live.dtb in the port workspace.
+ * SD is enabled for detection tests; internal storage and GPU remain disabled. Display is experimental.
+ */
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/usb/pd.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#define PMK8350_SID 6
+#include "sm6375.dtsi"
+#include <dt-bindings/soc/qcom,apr.h>
+#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/clock/qcom,sm6115-lpasscc.h>
+#include <dt-bindings/interconnect/qcom,sm6375-veux.h>
+#include <dt-bindings/interconnect/qcom,sm6375-veux-ipa.h>
+#include "pm6125.dtsi"
+#include "pmk8350.dtsi"
+#include "pmr735a.dtsi"
+
+/* PM6125 owns the power key/reset; avoid duplicate pon labels. */
+/delete-node/ &pmk8350_pon;
+/* The common SoC tree describes a different firmware carveout layout. */
+/delete-node/ &pil_cdsp_mem;
+/delete-node/ &pil_video_mem;
+/delete-node/ &pil_ipa_fw_mem;
+/delete-node/ &pil_ipa_gsi_mem;
+/delete-node/ &pil_gpu_micro_code_mem;
+
+/ {
+	model = "Xiaomi Redmi Note 11 Pro 5G";
+	compatible = "xiaomi,veux", "qcom,sm6375";
+	chassis-type = "handset";
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_default>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pmr735a_gpios 1 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	touch_dvdd: regulator-touch-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch-dvdd";
+		gpio = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <3000>;
+	};
+
+	touch_avdd: regulator-touch-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "touch-avdd";
+		gpio = <&tlmm 51 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <700>;
+	};
+
+	cam_main_vdig: regulator-camera-main-vdig {
+		compatible = "regulator-fixed";
+		regulator-name = "camera-main-vdig";
+		regulator-min-microvolt = <1050000>;
+		regulator-max-microvolt = <1050000>;
+		gpio = <&tlmm 58 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <135>;
+		vin-supply = <&pm6125_s6>;
+	};
+
+	/*
+	 * Stock firmware and the captured stock FDT do not expose an amp rail
+	 * switch; both amplifiers were already responsive on the live board.
+	 * Model that externally powered rail as fixed and always on. This node
+	 * has no GPIO or PMIC handle and therefore never toggles board power.
+	 */
+	aw88261_dvdd: regulator-aw88261-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "aw88261-dvdd-unmanaged";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	/* Diagnostic handoff only; no panel driver or display modesetting. */
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@85200000 {
+			compatible = "simple-framebuffer";
+			status = "disabled";
+			reg = <0 0x85200000 0 0xc00000>;
+			width = <1080>;
+			height = <2400>;
+			/* Firmware pitch/format still require hardware verification. */
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+			clocks = <&gcc GCC_DISP_AHB_CLK>,
+				 <&gcc GCC_DISP_HF_AXI_CLK>,
+				 <&gcc GCC_DISP_THROTTLE_CORE_CLK>,
+				 <&gcc GCC_DISP_GPLL0_DIV_CLK_SRC>;
+		};
+	};
+
+	reserved-memory {
+		cont_splash_mem: framebuffer@85200000 {
+			reg = <0 0x85200000 0 0xc00000>;
+			no-map;
+		};
+		pil_cdsp_mem: pil-cdsp@89300000 {
+			reg = <0 0x89300000 0 0x1e00000>;
+			no-map;
+		};
+		pil_video_mem: pil-video@8b100000 {
+			reg = <0 0x8b100000 0 0x500000>;
+			no-map;
+		};
+		pil_ipa_fw_mem: pil-ipa-fw@8b600000 {
+			reg = <0 0x8b600000 0 0x10000>;
+			no-map;
+		};
+		pil_ipa_gsi_mem: pil-ipa-gsi@8b610000 {
+			reg = <0 0x8b610000 0 0xa000>;
+			no-map;
+		};
+		pil_gpu_micro_code_mem: pil-gpu-ucode@8b61a000 {
+			reg = <0 0x8b61a000 0 0x2000>;
+			no-map;
+		};
+		ramoops@d0000000 {
+			compatible = "ramoops";
+			reg = <0 0xd0000000 0 0x200000>;
+			record-size = <0x100000>;
+			/* Keep the first 1 MiB panic record compatible with recovery. */
+			console-size = <0x80000>;
+			pmsg-size = <0x80000>;
+			ecc-size = <16>;
+			max-reason = <4>;
+		};
+	};
+};
+
+&pil_adsp_mem {
+	reg = <0 0x86700000 0 0x2c00000>;
+};
+
+&pon_pwrkey {
+	status = "okay";
+};
+
+&pon_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm6125-regulators";
+		/* Stock camera VDIG is fed from the PM6125 S6 rail. */
+		pm6125_s6: s6 {
+			regulator-min-microvolt = <1352000>;
+			regulator-max-microvolt = <1374000>;
+		};
+		pm6125_l2: l2 {
+			regulator-min-microvolt = <1170000>;
+			regulator-max-microvolt = <1304000>;
+		};
+		pm6125_l16: l16 {
+			regulator-min-microvolt = <1620000>;
+			regulator-max-microvolt = <1980000>;
+		};
+		pm6125_l21: l21 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+		};
+		pm6125_l23: l23 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+		};
+		/* Initial SD test uses 2.96 V I/O, without UHS voltage switching. */
+		pm6125_l4: l4 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+		};
+		pm6125_l5: l5 {
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+		};
+		pm6125_l22: l22 {
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+		};
+		pm6125_l7: l7 {
+			regulator-min-microvolt = <880000>;
